#!/usr/bin/env bash
# `mix sobelow` without the noise: Sobelow parses mix.lock as code, and Elixir
# 1.19 warns about every quoted key in it. Everything else it prints, and its
# exit status, come through untouched. Settings are in .sobelow-conf.
#
#   scripts/sobelow            scan the project
#   scripts/sobelow --verbose  any other `mix sobelow` option

cd "$(dirname "$0")/.." || exit 1

out=$(mktemp)
trap 'rm -f "$out"' EXIT

mix sobelow "$@" >"$out" 2>&1
status=$?

grep -v -E '^warning: found quoted keyword|nofile:[0-9]+:[0-9]+$' "$out" | cat -s | sed '/./,$!d'
exit "$status"
