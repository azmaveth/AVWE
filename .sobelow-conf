# Sobelow's settings: `mix sobelow` (or scripts/sobelow, which CI and the
# pre-push hook use) reads this file.
#
# A finding that was looked at and is fine carries a `# sobelow_skip [...]`
# comment above its function, with the reason beside it (see lib/avwe/store.ex),
# so a new one still fails the scan. Ignoring a whole check here is only for
# what cannot apply.
[
  exit: :low,
  format: "txt",
  # Config.HTTPS wants `force_ssl` on the endpoint. Nothing here terminates
  # TLS: the web client, MCP and telnet listen on 127.0.0.1 only, and whatever
  # makes any of them reachable from elsewhere puts TLS in front (see
  # docs/m2-spec.md, 3.4). Forcing it would make loopback unusable.
  ignore: ["Config.HTTPS"],
  ignore_files: [],
  include_mix_tasks: false,
  include_scripts: false,
  out: nil,
  private: true,
  skip: true,
  summary: false,
  threshold: :low,
  verbose: false
]
