#!/usr/bin/env bash
# Runs `mix lint` (format check, unused deps, compile with warnings as errors,
# credo) when a commit touches Elixir code or deps: about a second on a warm
# build. CI runs the same checks, and the slower ones too.
#
#   git config core.hooksPath .githooks    turn the hooks on, once per clone
#   git commit --no-verify                 skip them for one commit
#
# It checks the working tree, not only what is staged.

cd "$(git rev-parse --show-toplevel)" || exit 1

git diff --cached --name-only --diff-filter=ACMRD |
  grep -Eq '\.(ex|exs)$|^mix\.lock$' || exit 0

if ! command -v mix >/dev/null 2>&1; then
  echo "pre-commit: mix is not on PATH, so mix lint was skipped (CI will run it)." >&2
  exit 0
fi

echo "pre-commit: mix lint"
if ! mix lint; then
  echo >&2
  echo "pre-commit: mix lint failed. mix format fixes formatting; --no-verify skips this once." >&2
  exit 1
fi
